# ---------------------------------------------------------------------------
# Production .env for api.YOURDOMAIN.com (Namecheap Stellar / cPanel).
# Copy to `.env` on the server, fill every CHANGE_ME, then:
#   php artisan key:generate
#   php artisan migrate --force
# Never commit the real .env.
# ---------------------------------------------------------------------------

APP_NAME="Amar Inner"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.YOURDOMAIN.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database: create it in cPanel > MySQL Databases, then paste the values.
# cPanel prefixes both the DB name and the user with your account, e.g.
# "cpanelusr_amarinner" / "cpanelusr_api".
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME_dbname
DB_USERNAME=CHANGE_ME_dbuser
DB_PASSWORD=CHANGE_ME_dbpass

# Shared hosting has no Redis/daemon — keep everything on the database/file.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave null unless the admin panel is served from a specific host.
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Who may call the API from a browser. No trailing slash, comma-separated.
CORS_ALLOWED_ORIGINS="https://YOURDOMAIN.com,https://www.YOURDOMAIN.com"

# --- Mail: use the cPanel mailbox you created (Email Accounts).
MAIL_MAILER=smtp
MAIL_HOST=mail.YOURDOMAIN.com
MAIL_PORT=465
MAIL_USERNAME=noreply@YOURDOMAIN.com
MAIL_PASSWORD=CHANGE_ME_mailboxpass
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS="noreply@YOURDOMAIN.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Meta pixel + Conversions API (same pixel id the frontend uses).
META_PIXEL_ID=CHANGE_ME
META_CAPI_ACCESS_TOKEN=CHANGE_ME
META_CAPI_TEST_EVENT_CODE=
META_CAPI_CURRENCY=BDT

# --- First /admin login. Used only by AdminUserSeeder (see DEPLOY.md, no-SSH
# path). After it has run once, DELETE the password line below.
ADMIN_NAME="Admin"
ADMIN_EMAIL=CHANGE_ME@YOURDOMAIN.com
ADMIN_PASSWORD=CHANGE_ME_pick_a_strong_one
