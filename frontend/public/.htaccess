# SPA fallback: every path that isn't a real file or folder is served by
# index.html so client-side routes like /guddi-bra work on a direct hit.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Only /assets/ carries a content hash in its filename, so only it is safe to
  # cache forever. Images in the web root keep stable names and may be swapped.
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/assets/" HASHED_ASSET
  </IfModule>
  Header set Cache-Control "public, max-age=31536000, immutable" env=HASHED_ASSET
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
