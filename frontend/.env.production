# Baked into the static bundle by `vite build`. No secrets here — the pixel id
# and API URL are visible in the shipped JS anyway.
VITE_API_URL=https://api.amarinner.com/api

# Same pixel id as the backend's META_PIXEL_ID. Empty = pixel disabled.
VITE_META_PIXEL_ID=1047723304555077
VITE_META_CURRENCY=BDT
